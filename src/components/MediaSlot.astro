---
/**
 * Site media primitive — the single entry point for content imagery.
 *
 * Every content image on the site renders through this component and is
 * governed by the Global Locked Media Policy (docs/media-policy.md):
 *
 *  - Build output is ALWAYS the locked state: a near-black editorial
 *    surface with the exact final geometry (ratio + classes), carrying
 *    the media descriptor in `data-media-config`.
 *  - The shared controller in BaseLayout injects the real <picture>/<img>
 *    only when the session is unlocked (JZ. ×5 within 3s), so a locked
 *    session issues zero content-image requests.
 *  - No-JS visitors permanently see the locked surface (accepted
 *    fallback); text, navigation and links remain fully usable.
 *  - Art direction is preserved: per-breakpoint sources, sizes,
 *    object-position, ratio, eager/fetchpriority, alt, width/height.
 *
 * Frames without `src`/`sources` are development placeholders (marker
 * label) and are not part of the locked-media system.
 */

interface MediaSource {
  /** CSS media query this source applies to (omit = fallback). */
  media?: string;
  /** Image URL for this breakpoint. */
  src: string;
  /** Intrinsic dimensions of this source's file. */
  width?: number;
  height?: number;
  /** Optional sizes hint, forwarded to the source element. */
  sizes?: string;
}

interface Props {
  /** CSS aspect-ratio, e.g. '3 / 2'. Used by all states. */
  ratio?: string;
  /** Real image source — omit for the development placeholder. */
  src?: string;
  /** Art-directed breakpoint sources; resolved as a <picture>. */
  sources?: MediaSource[];
  /** Required whenever src/sources is set. */
  alt?: string;
  width?: number;
  height?: number;
  /** object-position for real images, e.g. 'center 30%'. */
  position?: string;
  /** Development marker text, e.g. 'MEDIA / 01'. Placeholder state only. */
  label?: string;
  /** Hero-critical media hydrates eager; everything else defaults to lazy. */
  eager?: boolean;
  class?: string;
}

const {
  ratio = '3 / 2',
  src,
  sources,
  alt,
  width,
  height,
  position = 'center',
  label = 'MEDIA',
  eager = false,
  class: className,
} = Astro.props;

// The fallback image uses the last source (no media query) when
// art-directing, otherwise the plain src prop.
const fallback = sources?.[sources.length - 1];
const imgSrc = fallback?.src ?? src;
const imgWidth = fallback?.width ?? width;
const imgHeight = fallback?.height ?? height;

// Descriptor consumed by the runtime controller in BaseLayout. The real
// img is created client-side only — never at build time — so a locked
// session downloads nothing.
const config = imgSrc
  ? {
      src: imgSrc,
      width: imgWidth,
      height: imgHeight,
      alt: alt ?? '',
      position,
      eager,
      sources: sources?.map((s) => ({ media: s.media, src: s.src, width: s.width, height: s.height })),
    }
  : null;
---

{
  config ? (
    <div
      class:list={['site-media media-frame', className]}
      style={`aspect-ratio: ${ratio};`}
      data-media-config={JSON.stringify(config)}
    />
  ) : (
    <div
      class:list={['media-frame media-placeholder', className]}
      style={`aspect-ratio: ${ratio};`}
      aria-hidden="true"
    >
      <span class="media-marker">{label}</span>
    </div>
  )
}

<style>
  .media-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    background: var(--color-bg-subtle);
    border: var(--border-hairline);
  }

  .media-marker {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
  }

  :global(html[lang='zh-CN']) .media-marker {
    letter-spacing: 0.16em;
  }
</style>
