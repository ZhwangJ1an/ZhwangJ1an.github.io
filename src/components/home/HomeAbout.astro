---
/**
 * 01 / About — text-dominant. Answers one question: what does this
 * person pay attention to? Brand expression, not biography.
 */

import type { Lang } from '../../i18n/config.ts';
import { getHomeCopy } from '../../data/home.ts';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getHomeCopy(lang);
---

<section class="about section-lg" id="about">
  <div class="container">
    <p class="section-label t-label t-faint" data-reveal>{copy.aboutLabel}</p>
    <p class="about-statement" data-reveal>
      {copy.aboutStatement.map((line, i) => (
        <span class="statement-line" style={`--l: ${i}`}>{line}</span>
      ))}
    </p>
    <a class="link-arrow t-body" data-reveal href={getRelativeLocaleUrl(lang, 'about')}>
      {lang === 'zh' ? '关于' : 'About'}
    </a>
  </div>
</section>

<style>
  .about-statement {
    margin-block: var(--space-md) var(--space-lg);
  }

  .statement-line {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.12;
  }

  :global(html[lang='zh-CN']) .statement-line {
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
</style>
