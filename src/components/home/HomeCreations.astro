---
/**
 * 03 / Creations — the one inverse section on the homepage: near-black,
 * cinematic. Video/demo territory; the media slot is a design element,
 * not a fake player — no pretend controls, no play statistics.
 */

import type { Lang } from '../../i18n/config.ts';
import { getHomeCopy } from '../../data/home.ts';
import { getRelativeLocaleUrl } from 'astro:i18n';
import MediaSlot from '../MediaSlot.astro';
import creationsShot from '../../assets/home/creations.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getHomeCopy(lang);
---

<section class="creations section-inverse section-xl">
  <div class="container">
    <p class="section-label t-label t-faint" data-reveal>{copy.creationsLabel}</p>

    <div class="creations-head" data-reveal>
      <h2 class="creations-heading">{copy.creationsHeading}</h2>
      <p class="creations-support t-body t-muted">{copy.creationsSupport}</p>
    </div>
  </div>

  <div class="container-wide">
    <div class="creations-media" data-reveal>
      <MediaSlot
        ratio="16 / 9"
        src={creationsShot.src}
        width={creationsShot.width}
        height={creationsShot.height}
        alt={copy.creationsMediaAlt}
      />
    </div>
    <p class="creations-cta" data-reveal>
      <a class="link-arrow t-body" href={getRelativeLocaleUrl(lang, 'creations')}>{copy.creationsCta}</a>
    </p>
  </div>
</section>

<style>
  .creations {
    /* Full-bleed section ground, edges to the page frame. */
    inline-size: 100%;
  }

  .creations-head {
    margin-block: var(--space-sm) var(--space-lg);
  }

  .creations-heading {
    font-family: var(--font-display);
    font-size: var(--text-display-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.02;
    overflow-wrap: normal;
    max-width: 24ch;
    /* zh copy embeds controlled breaks via \n (see data/home.ts). */
    white-space: pre-line;
  }

  :global(html[lang='zh-CN']) .creations-heading {
    font-size: var(--text-display-md);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .creations-support {
    margin-block-start: var(--space-sm);
  }

  .creations-cta {
    margin-block-start: var(--space-lg);
  }
</style>
