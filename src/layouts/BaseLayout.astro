---
import { htmlLang, type Lang } from '../i18n/config.ts';
import { localizePath, t } from '../i18n/utils.ts';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/global.css';

interface Props {
  /** URL locale of the page being rendered. */
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description = 'Researcher · Engineer · Builder' } = Astro.props;

// Every language version is self-canonical — the Chinese page never points
// at the English URL and vice versa.
const site = Astro.site ?? new URL('https://zhuangjian.space');
const enHref = new URL(localizePath(Astro.url.pathname, 'en'), site).href;
const zhHref = new URL(localizePath(Astro.url.pathname, 'zh'), site).href;
const canonicalHref = lang === 'en' ? enHref : zhHref;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <!-- Marks JS availability before first paint: the mobile menu panel
         only switches to the fixed overlay in the enhanced (js) state. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(lang, 'skipToContent')}</a>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />

    <script>
      // Scroll-entrance enhancement (shared site-wide, one observer for
      // every [data-reveal] element). The hidden pre-reveal state is keyed
      // on html.js (set synchronously in <head>, before first paint), so
      // elements never paint visible and then hide — no reveal flash.
      // No-JS and reduced-motion users always see full content.
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        for (const el of targets) {
          observer.observe(el);
        }
      }
    </script>

    <script is:inline>
      // Global locked-media controller — the single instance for the whole
      // site (docs/media-policy.md). MediaSlot frames render only the
      // locked surface at build time; this controller injects the real
      // media elements when — and only when — the session is unlocked via
      // the hidden gesture: 5 clicks/taps on the brand link within 3s,
      // while already on the current-language home. Keyboard activation
      // (event.detail === 0) keeps normal anchor navigation. One handler,
      // one state key (sessionStorage), no framework, no dependencies.
      (function () {
        var KEY = 'siteMediaUnlocked';
        var WINDOW_MS = 3000;
        var TAPS = 5;

        function isUnlocked() {
          try {
            return sessionStorage.getItem(KEY) === '1';
          } catch (e) {
            return false;
          }
        }

        function writeState(value) {
          try {
            sessionStorage.setItem(KEY, value ? '1' : '0');
          } catch (e) {
            /* storage unavailable: state simply stays per-page */
          }
        }

        var frames = Array.prototype.slice.call(document.querySelectorAll('[data-media-config]'));

        function buildMedia(el) {
          var cfg;
          try {
            cfg = JSON.parse(el.getAttribute('data-media-config'));
          } catch (e) {
            return;
          }
          var pic = document.createElement('picture');
          (cfg.sources || []).forEach(function (s) {
            if (!s.media) return;
            var source = document.createElement('source');
            source.media = s.media;
            source.srcset = s.src;
            pic.appendChild(source);
          });
          var img = document.createElement('img');
          img.src = cfg.src;
          img.alt = cfg.alt || '';
          if (cfg.width) img.width = cfg.width;
          if (cfg.height) img.height = cfg.height;
          // Unlocked sessions explicitly asked for media: load every frame
          // eagerly (laziness is meaningless when locked — nothing loads at
          // all — and decode() would stall on offscreen lazy images).
          img.loading = 'eager';
          img.decoding = cfg.eager ? 'sync' : 'async';
          if (cfg.eager && 'fetchPriority' in img) img.fetchPriority = 'high';
          img.style.objectPosition = cfg.position || 'center';
          img.addEventListener(
            'error',
            function () {
              // Failed loads fall back to the locked surface — never the
              // browser's broken-image UI.
              img.remove();
              delete el.dataset.hydrated;
              el.classList.remove('is-media-ready');
              console.warn('[site-media] load failed:', cfg.src);
            },
            { once: true },
          );
          pic.appendChild(img);
          el.appendChild(pic);
          var reveal = function () {
            el.classList.add('is-media-ready');
          };
          if (img.complete && img.naturalWidth > 0) {
            reveal();
          } else {
            img.addEventListener('load', reveal, { once: true });
          }
        }

        function hydrateAll() {
          frames.forEach(function (el) {
            if (!el.dataset.hydrated) {
              el.dataset.hydrated = '1';
              buildMedia(el);
            }
          });
        }

        function dehydrateAll() {
          frames.forEach(function (el) {
            var pic = el.querySelector('picture');
            if (pic) pic.remove();
            delete el.dataset.hydrated;
            el.classList.remove('is-media-ready');
          });
        }

        function apply() {
          if (isUnlocked()) {
            hydrateAll();
          } else {
            dehydrateAll();
          }
        }

        apply();

        var brand = document.querySelector('.site-header .brand');
        if (brand) {
          var taps = 0;
          var lastTapAt = 0;
          brand.addEventListener('click', function (e) {
            if (e.detail === 0) return; // keyboard activation: normal link
            if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
            var target = (brand.getAttribute('href') || '/').replace(/\/+$/, '') || '/';
            var here = location.pathname.replace(/\/+$/, '') || '/';
            if (here !== target) return; // off home: a click navigates normally
            e.preventDefault(); // on home: stay, so the sequence can complete
            var now = Date.now();
            if (now - lastTapAt > WINDOW_MS) taps = 0;
            lastTapAt = now;
            taps += 1;
            if (taps >= TAPS) {
              taps = 0;
              writeState(!isUnlocked());
              apply();
            }
          });
        }
      })();
    </script>
  </body>
</html>
