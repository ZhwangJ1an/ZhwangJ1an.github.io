---
/**
 * DEVELOPMENT ONLY — temporary design-system preview for Phase 3 QA.
 * Must be deleted before any production merge.
 * Renders the real system (tokens, type, layout, links, motion) — the
 * page itself is the test artifact.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Style Guide — Jian Zhuang (development only)"
  description="Development-only design system preview. Not for publication."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main">
    <div class="dev-banner" role="note">
      <p class="t-label">Development only — not for production</p>
    </div>

    <!-- ============================================================
         01 · COLORS
         ============================================================ -->
    <section class="section-lg container">
      <h2 class="t-label t-faint">01 — Colors</h2>
      <h2 class="t-heading-lg section-heading">Paper &amp; ink, one accent.</h2>
      <ul role="list" class="swatch-list">
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-bg); border: var(--border-hairline);`}></span>
          <span class="swatch-name t-body">bg — paper ground</span>
          <span class="t-meta t-faint">#FAF8F4</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-bg-subtle);`}></span>
          <span class="swatch-name t-body">bg-subtle — alternate sections / media</span>
          <span class="t-meta t-faint">#F1EEE7</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-surface); border: var(--border-hairline);`}></span>
          <span class="swatch-name t-body">surface — behind imagery</span>
          <span class="t-meta t-faint">#FFFEFB</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-text);`}></span>
          <span class="swatch-name t-body">text — warm ink</span>
          <span class="t-meta t-faint">#1C1915</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-text-muted);`}></span>
          <span class="swatch-name t-body">text-muted</span>
          <span class="t-meta t-faint">#6D665E</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-text-faint);`}></span>
          <span class="swatch-name t-body">text-faint — meta, captions</span>
          <span class="t-meta t-faint">#9B948A</span>
        </li>
        <li class="swatch-row">
          <span class="swatch swatch-hairline"></span>
          <span class="swatch-name t-body">border — hairline rules</span>
          <span class="t-meta t-faint">#E2DDD4</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-accent);`}></span>
          <span class="swatch-name t-body">accent — links, selection, data</span>
          <span class="t-meta t-faint">#B2452C</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-accent-soft);`}></span>
          <span class="swatch-name t-body">accent-soft — selected backgrounds</span>
          <span class="t-meta t-faint">#F3E4DE</span>
        </li>
        <li class="swatch-row">
          <span class="swatch" style={`background: var(--color-inverse-bg); border: var(--border-hairline);`}></span>
          <span class="swatch-name t-body">inverse-bg — immersive sections only</span>
          <span class="t-meta t-faint">#171410</span>
        </li>
      </ul>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />

    <!-- ============================================================
         02 · ENGLISH TYPOGRAPHY
         ============================================================ -->
    <section class="section-lg container">
      <h2 class="t-label t-faint">02 — English typography</h2>

      <p class="t-display-xl specimen">JIAN ZHUANG</p>
      <p class="t-display-lg specimen">Research.<br />Technology.<br />Creation.<br />Life.</p>
      <p class="t-display-md specimen">Understanding flows through data.</p>
      <p class="t-body-lg t-muted specimen">Researcher · Engineer · Builder</p>

      <hr class="rule specimen-rule" />

      <h3 class="t-heading-xl specimen">Field notes from the boundary layer</h3>
      <h3 class="t-heading-lg specimen">Turbulence is a measurement problem</h3>
      <h3 class="t-heading-md specimen">A shorter heading for dense layouts</h3>

      <p class="t-body-lg specimen">
        The velocity field is reconstructed from synchronized particle images;
        uncertainty is quantified per vector, not per plane.
      </p>
      <p class="t-body specimen">
        Every flow we study is also a data problem. The images arrive faster
        than intuition, and the interesting structure hides between frames —
        in the <a class="link-inline" href="#02">residual of the model</a>, in the
        span between what the sensor resolved and what the physics knows.
        That span is where this site lives.
      </p>

      <div class="type-utilities">
        <span class="t-label">Label — section eyebrows</span>
        <span class="t-meta t-muted">Meta — 2026.08 · PIV · 12 min</span>
        <span class="t-caption">Caption — Fig. 3: vorticity field behind a pitching foil.</span>
        <a class="link-arrow t-body" href="#07">Explore project</a>
        <a class="link-label" href="#05">More in Insights</a>
      </div>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />

    <!-- ============================================================
         03 · CHINESE TYPOGRAPHY  (lang="zh-CN" — independent metrics)
         ============================================================ -->
    <section class="section-lg container">
      <h2 class="t-label t-faint">03 — Chinese typography</h2>
      <div lang="zh-CN">
        <p class="t-display-xl specimen">庄简</p>
        <p class="t-display-lg specimen">研究<br />技术<br />创作<br />生活</p>
        <p class="t-display-md specimen">用数据理解流动。</p>
        <p class="t-body-lg t-muted specimen">研究者 · 工程实践 · 创作者</p>

        <hr class="rule specimen-rule" />

        <h3 class="t-heading-lg specimen">实验流体，与它背后的数据方法</h3>
        <h3 class="t-heading-md specimen">小标题在密集版面中的表现</h3>

        <p class="t-body specimen">
          粒子图像测速以每秒数千帧记录流场，把光的真实运动转化为向量。每一帧都是一次测量，每一次测量都带着不确定性——理解流动，就是理解这些不确定的边界。
        </p>
        <p class="t-body-sm specimen">
          中文正文采用更宽松的行距与字距：标点悬挂、密度与西文不同，不能机械套用同一套排版参数。这里的每一段都在检验行高、字距与换行的实际效果。
        </p>

        <div class="type-utilities">
          <span class="t-label">标签 —— 眉题样式</span>
          <span class="t-meta t-muted">日期 —— 2026.08 · 实验记录</span>
          <span class="t-caption">图注 —— 图 3：俯仰翼后的涡量场。</span>
          <a class="link-arrow t-body" href="#07">查看项目</a>
        </div>
      </div>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />

    <!-- ============================================================
         04 · MOTION
         ============================================================ -->
    <section class="section-lg container">
      <h2 class="t-label t-faint">04 — Motion</h2>
      <h2 class="t-heading-lg section-heading">A closed, quiet vocabulary.</h2>
      <div class="type-utilities">
        <span class="t-meta t-muted">--duration-fast 150ms · --duration-base 250ms · --duration-slow 600ms</span>
        <span class="t-meta t-muted">--ease-standard · --ease-out · --ease-editorial</span>
      </div>
      <p class="t-body specimen">
        Hover the chip: 600ms editorial ease, transform only. Reduced-motion
        preferences collapse every transition to near-instant; content is
        never hidden behind animation states.
      </p>
      <div class="motion-chip t-body" tabindex="0">hover me — transform · 600ms · ease-editorial</div>
    </section>

    <!-- ============================================================
         SPECIMEN A · HERO TYPOGRAPHY
         ============================================================ -->
    <section class="section-xl container-wide" id="05">
      <p class="t-label t-faint specimen">01 / JIAN ZHUANG</p>
      <p class="t-display-xl specimen" style="line-height: 0.94">
        JIAN<br />ZHUANG
      </p>
      <p class="t-body-lg t-muted specimen">Research · Technology · Creation · Life</p>
    </section>

    <!-- ============================================================
         SPECIMEN B · SECTION INTRO
         ============================================================ -->
    <section class="section-lg container" id="06">
      <p class="t-label t-faint specimen">Insights</p>
      <p class="t-display-lg specimen">Understanding<br />flows through<br />data.</p>
      <p class="t-body-lg t-muted specimen">Ideas, research and things I've been building.</p>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />

    <!-- ============================================================
         SPECIMEN C · MEDIA COMPOSITION
         ============================================================ -->
    <section class="section-lg container" id="07">
      <h2 class="t-label t-faint">07 — Media composition</h2>
      <h2 class="t-heading-lg section-heading">Image-led, weight-first.</h2>

      <div class="media-placeholder media-ratio-landscape media-zoom" style="margin-block-end: var(--space-lg)">
        <span>Image placeholder · 3:2</span>
      </div>

      <div class="full-bleed media-placeholder media-ratio-wide">
        <span>Full-bleed placeholder · 16:9</span>
      </div>

      <div class="grid-12" style="margin-block-start: var(--space-lg)">
        <div class="media-placeholder media-ratio-portrait span-portrait">
          <span>Portrait · 4:5</span>
        </div>
        <div class="span-portrait-copy">
          <h3 class="t-heading-lg">Asymmetric pairing</h3>
          <p class="t-body t-muted">
            A portrait image offset against a narrow copy column — the
            grid exists to allow this, not to forbid it.
          </p>
          <a class="link-arrow t-body" href="#08">Read the note</a>
        </div>
      </div>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />

    <!-- ============================================================
         SPECIMEN D · CONTENT INDEX  (hairlines, never cards)
         ============================================================ -->
    <section class="section-lg container" id="08">
      <h2 class="t-label t-faint">08 — Content index</h2>
      <p class="t-meta t-faint specimen">2026</p>
      <ol role="list" class="index-list">
        <li>
          <span class="index-number">01</span>
          <span class="index-title t-body-lg">Explainable Deep Learning</span>
          <span class="index-category">Research</span>
        </li>
        <li>
          <span class="index-number">02</span>
          <span class="index-title t-body-lg">CoSlide</span>
          <span class="index-category">Project</span>
        </li>
        <li>
          <span class="index-number">03</span>
          <span class="index-title t-body-lg">Flow Image Enhancement</span>
          <span class="index-category">Paper</span>
        </li>
      </ol>
    </section>

    <!-- ============================================================
         09 · INVERSE SECTION  (immersive preview — not a dark mode)
         ============================================================ -->
    <section class="section-xl container-wide section-inverse" id="09">
      <h2 class="t-label t-faint">09 — Inverse surface</h2>
      <p class="t-display-lg specimen">Creation,<br />in motion.</p>
      <p class="t-body-lg t-muted specimen">
        Near-black ground reserved for film, demos and immersive work.
        Tokens re-map locally; no theme switch exists.
      </p>
      <div class="media-placeholder media-ratio-wide" style="margin-block-start: var(--space-lg)">
        <span>Immersive media placeholder · 16:9</span>
      </div>
      <p class="specimen">
        <a class="link-arrow t-body" href="#main">Enter Creations</a>
      </p>
    </section>

    <!-- ============================================================
         10 · EDITORIAL GRID
         ============================================================ -->
    <section class="section-xl container">
      <h2 class="t-label t-faint">10 — Grid</h2>
      <div class="grid-12" style="margin-block-start: var(--space-md)">
        <p class="t-heading-lg grid-demo-primary">
          Twelve columns are available; asymmetry is the point.
        </p>
        <p class="t-body t-muted grid-demo-secondary">
          On mobile this collapses to four; on tablet, six. The grid is an
          alignment reference — content spans it freely.
        </p>
      </div>
    </section>

    <hr class="rule" style="margin-inline: var(--page-gutter)" />
    <footer class="section container" style="padding-block-end: var(--section-space-lg)">
      <p class="t-meta t-faint">End of style guide — delete /dev/style-guide before production.</p>
    </footer>
  </main>

  <style>
    /* Style-guide-local scaffolding only — presentation of the specimens.
       Real site pages get no page-level <style> blocks. */
    .dev-banner {
      background: var(--color-accent-soft);
      color: var(--color-accent-hover);
      padding: var(--space-xs) var(--page-gutter);
      text-align: center;
    }

    .section-heading {
      margin-block: var(--space-sm) var(--space-lg);
    }

    .specimen {
      margin-block-end: var(--space-md);
    }

    .specimen-rule {
      margin-block: var(--space-md);
    }

    .type-utilities {
      display: grid;
      gap: var(--space-xs);
      justify-items: start;
      margin-block-start: var(--space-md);
    }

    .swatch-list {
      display: grid;
      gap: var(--space-sm);
      margin-block-start: var(--space-lg);
    }

    .swatch-row {
      display: grid;
      grid-template-columns: minmax(4.5rem, 7rem) 1fr auto;
      gap: var(--space-sm);
      align-items: center;
    }

    .swatch {
      display: block;
      height: 3rem;
      border-radius: var(--radius-sm);
    }

    .swatch-hairline {
      background: var(--color-bg);
      border: var(--border-hairline);
    }

    .motion-chip {
      display: inline-block;
      margin-block-start: var(--space-md);
      padding: 0.9em 1.4em;
      border: var(--border-hairline);
      border-radius: var(--radius-sm);
      cursor: default;
      transition: transform var(--duration-slow) var(--ease-editorial);
    }

    .motion-chip:hover,
    .motion-chip:focus-visible {
      transform: translateY(-4px);
    }

    .span-portrait {
      grid-column: 1 / -1;
    }

    .span-portrait-copy {
      grid-column: 1 / -1;
    }

    @media (min-width: 68em) {
      .span-portrait { grid-column: 2 / span 4; }
      .span-portrait-copy { grid-column: 7 / span 5; align-self: center; }
      .grid-demo-primary { grid-column: 1 / span 7; }
      .grid-demo-secondary { grid-column: 9 / span 4; align-self: end; }
    }
  </style>

  <script>
    // QA-only: with #qa-overflow in the URL, expose scroll metrics on <html>
    // for headless --dump-dom harvesting. No effect in normal browsing.
    if (location.hash === '#qa-overflow') {
      const root = document.documentElement;
      root.dataset.qaScrollWidth = String(root.scrollWidth);
      root.dataset.qaInnerWidth = String(window.innerWidth);
    }
  </script>
</BaseLayout>
